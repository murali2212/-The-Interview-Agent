# Copy to .env and fill in. Every value here is optional — with none of them set
# the interview still runs end to end on the deterministic offline engine.

# --- Language model (phase one) ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Force the offline engine even when a key is present. Useful for tests and for
# a demo that must not depend on anyone's rate limit.
OFFLINE_ONLY=false

# --- Retrieval ------------------------------------------------------------
# Runs locally via sentence-transformers. No key required.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RETRIEVAL=true

# --- Voice (phase two) ----------------------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
