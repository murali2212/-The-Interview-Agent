# Copy to .env and fill in. Every value here is optional — with none of them set
# the interview still runs end to end on the deterministic offline engine.

# --- Language model (phase one) ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Force the offline engine even when a key is present. Useful for tests and for
# a demo that must not depend on anyone's rate limit.
OFFLINE_ONLY=false

# --- Retrieval ------------------------------------------------------------
# Runs locally via sentence-transformers. No key required.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RETRIEVAL=true

# --- Voice ----------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Session persistence ----------------------------------------------------
# Optional. Without these, sessions live only in this process's memory, which
# is fine for local dev but means a backend restart mid-interview drops the
# session. Set both to persist sessions to a Supabase Postgres table instead
# (see app/session.py for the one-time SQL to create it). SUPABASE_SERVICE_ROLE_KEY
# bypasses Row Level Security — keep it out of any client-shipped file, it
# belongs only in this backend's environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
